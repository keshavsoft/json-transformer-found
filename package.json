{
  "name": "json-transformer-found",
  "version": "1.3.1",
  "description": "Transform source JSON with declarative JSON instructions",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "files": [
    "src",
    "docs",
    "samples",
    "README.md"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sample": "node ./samples/new/receipts/index.js",
    "sample:stock-items": "node ./samples/new/batches/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavsoft/json-transformer-found.git"
  },
  "keywords": [
    "json-transformer",
    "json",
    "transform",
    "mapping",
    "declarative"
  ],
  "author": "KeshavSoft",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "bugs": {
    "url": "https://github.com/keshavsoft/json-transformer-found/issues"
  },
  "homepage": "https://keshavsoft.github.io/json-transformer-found/",
  "devDependencies": {
    "vite": "^6.2.0"
  }
}
